# Copy to .env and fill in values

# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@swai-db:5432/swai

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_EXPIRES_MINUTES=60

# Database password — must match POSTGRES_PASSWORD in DATABASE_URL
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Field-level encryption for API keys at rest ───────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Database SSL (disable only for local dev) ─────────────────────────────────
DB_SSL=true

# ── LLM Backends ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434
LMSTUDIO_HOST=http://host.docker.internal:1234
LLM_MODEL=llama3

# ── Graph & Vector databases ─────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# ── External API keys (stored encrypted if FIELD_ENCRYPTION_KEY is set) ──────
OPENAI_API_KEY=
CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com/v1
ELEVENLABS_API_KEY=

# ── Security tuning ───────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins (defaults to localhost dev origins)
# ALLOWED_ORIGINS=https://yourdomain.com
# Replit project subdomain (exact, no wildcards)
# REPLIT_DEV_DOMAIN=your-project.replit.dev
MAX_BODY_SIZE_BYTES=10485760
MAX_UPLOAD_BYTES=20971520
LOGIN_RATE_MAX_ATTEMPTS=10
LOGIN_RATE_WINDOW_SECONDS=60
MIN_PASSWORD_LENGTH=8

# ── Storage & uploads ─────────────────────────────────────────────────────────
UPLOADS_DIR=/app/wwwroot/uploads

# ── TTS / STT GPU assignment ──────────────────────────────────────────────────
TTS_CUDA_VISIBLE_DEVICES=0
TTS_GPU_ID=0
STT_CUDA_VISIBLE_DEVICES=0
STT_GPU_ID=0

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_TRAEFIK_URL=
