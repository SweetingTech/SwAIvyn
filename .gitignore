# SwAIvyn .gitignore file

# =============================================================================
# BUILD OUTPUTS AND COMPILED FILES
# =============================================================================

# Build results
[Bb]in/
[Oo]bj/
[Dd]ist/
[Bb]uild/
[Rr]elease/
[Dd]ebug/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/

# Compiled output
*.com
*.class
*.dll
*.exe
*.pdb
*.so
*.dylib
*.o
*.obj

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# =============================================================================
# ROOT DIRECTORY CLEANUP
# =============================================================================

# Root directory DLL files (copied from build)
/*.dll
/*.exe
/*.pdb
/*.json
/*.config
/*.xml
/*.ico

# Specific root files that should be ignored
/SwAIvyn.exe
/SwAIvyn.dll
/SwAIvyn.pdb
/SwAIvyn.deps.json
/SwAIvyn.runtimeconfig.json
/SwAIvyn.staticwebassets.runtime.json
/SwAIvyn.staticwebassets.endpoints.json
/SwAIvyn.lnk
/appsettings.json
/web.config
/app-icon.ico

# Microsoft and System DLLs in root
/Microsoft.*.dll
/System.*.dll
/Humanizer.dll
/Neo4j.Driver.dll
/Newtonsoft.Json.dll
/SQLitePCLRaw.*.dll
/Swashbuckle.*.dll
/YamlDotNet.dll
/WindowsBase.dll

# Runtime files in root
/hostfxr.dll
/hostpolicy.dll
/coreclr.dll
/clr*.dll
/mscor*.dll
/netstandard.dll
/createdump.exe
/aspnetcorev2_inprocess.dll
/msquic.dll

# Native libraries in root
/e_sqlite3.dll
/sqlite-vss.dll
/faiss.dll
/libopenblas.dll

# =============================================================================
# FRONTEND AND NODE.JS
# =============================================================================

# Node.js
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
.pnp/
.pnp.js
.npm
.yarn/
.yarn-integrity
package-lock.json

# Frontend build output
frontend/dist/
frontend/build/
frontend/.cache/
frontend/coverage/
frontend/public/build/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Backend build output
backend/wwwroot/
backend/app-icon.ico

# =============================================================================
# DATABASES AND DATA
# =============================================================================

# Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Database backups
*.backup.*
Sqldatabase/
backend/Sqldatabase/
backend/*.db*

# Application data directories
data/
!data/.gitkeep
data/avatars/*
!data/avatars/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/backups/*
!data/backups/.gitkeep
data/modules/*
!data/modules/.gitkeep
data/sessions/*
!data/sessions/.gitkeep

# =============================================================================
# LOGS AND TEMPORARY FILES
# =============================================================================

# Logs
*.log
[Ll]og/
[Ll]ogs/
logs/
crash_*.txt

# Temporary files
[Tt]emp/
[Tt]mp/
*.tmp
*.temp

# =============================================================================
# DEVELOPMENT TOOLS AND IDEs
# =============================================================================

# Visual Studio files
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl
*.jfm
*.pfx
*.publishsettings

# IDE-specific files
.idea/
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
*.launch
*.tmproj
*.esproj
nbproject/
*.code-workspace

# =============================================================================
# THIRD-PARTY LIBRARIES AND DEPENDENCIES
# =============================================================================

# SQLite VSS and related
sqlite-vss/
sqlite-source/
windows-libs/

# Test projects and tools
CheckSqliteVersion/
DebugTool/
TestSqliteVss/
TestSqliteVssProject/
tools/
Tests/

# Search and speech modules
search/
speech/

# =============================================================================
# PACKAGE AND ARCHIVE FILES
# =============================================================================

# Package files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# =============================================================================
# OPERATING SYSTEM FILES
# =============================================================================

# User-specific files
*.rsuser
*.swp
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Windows shortcuts
*.lnk

# =============================================================================
# PROJECT-SPECIFIC IGNORES
# =============================================================================

# Build scripts output
dist/
wwwroot/

# Services directory (if it contains generated files)
Services/

# Vector database configuration
vectorDB/

# SQL scripts (development only)
*.sql
!backend/Migrations/*.sql

# Python cache
__pycache__/
*.pyc
*.pyo

# Assets that might be copied during build
assets/

# Documentation exports
*.json
!package.json
!frontend/package.json
!tsconfig*.json
!frontend/tsconfig*.json
